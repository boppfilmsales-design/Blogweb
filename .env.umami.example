# Umami 环境变量配置
# 复制为 .env.umami 并填入真实值

# 必填：Supabase PostgreSQL 连接字符串
# 格式：postgresql://postgres:<password>@<host>:<port>/postgres?pgbouncer=true&connection_limit=1
# 从 Supabase Dashboard → Settings → Database → Connection string → Transaction pooler 获取
# 注意：密码中的特殊字符需 URL 编码（$ → %24）
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# 必填：应用密钥（生成任意 32+ 字符随机串）
# 可用命令生成：openssl rand -base64 32
APP_SECRET=your-app-secret-here-min-32-chars

# 必填：哈希盐值（生成任意 32+ 字符随机串）
HASH_SALT=your-hash-salt-here-min-32-chars

# 可选：MaxMind GeoIP 更新密钥（启用地理位置解析）
# 免费注册：https://www.maxmind.com/en/geolite2/signup
# GEOIP_UPDATE_KEY=your-maxmind-license-key