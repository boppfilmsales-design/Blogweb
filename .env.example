# Blogweb — Cloudflare Pages (D1 + R2)
# No local database URL is needed: the app reads D1/R2 through the
# Cloudflare bindings configured in wrangler.toml / the Pages dashboard.
# Never commit real values for anything below; set them in the Pages dashboard
# (project "blogweb" -> Settings -> Environment variables / Bindings).

# Admin password. Set this for both Production and Preview.
# The code has no default password: until this is set, /admin/login returns 503
# and every admin API route fails closed with 401. POST /api/admin/auth sets an
# HttpOnly `aec_admin_session` cookie (7 days), signed with HMAC-SHA256.
ADMIN_PASSWORD=

# Optional: separate key used to sign the admin session cookie.
# When empty, ADMIN_PASSWORD is the signing key (so changing the password logs
# every existing admin session out).
ADMIN_SESSION_SECRET=

# Public base URL of the R2 bucket (e.g. https://pub-....r2.dev).
# Used for uploaded image URLs. Leave empty to serve uploads through
# the built-in /api/images proxy route instead.
R2_PUBLIC_URL=

# Inquiry notifications (POST /api/inquiry).
# Delivery goes through the `blogweb-email-sender` Worker, bound to this Pages
# project as the EMAIL_SENDER service binding
# (see workers/email-sender/README.md). Defaults are shown; only set these to
# change the addresses without a code change.
INQUIRY_FROM=AEC Group Inquiry <sale@apigcl.com>
INQUIRY_TO=message@boppfilmsale.com

# Optional second email channel, used when the EMAIL_SENDER binding is missing
# or fails: Resend API key. The `from` domain must be verified in Resend too.
RESEND_API_KEY=
